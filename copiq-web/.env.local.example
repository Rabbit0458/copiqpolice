# ──────────────────────────────────────────────────────────────────
#  COP'IQ Web — Variables d'environnement
#  Copier en .env.local et renseigner les vraies valeurs
#  NE JAMAIS committer .env.local
# ──────────────────────────────────────────────────────────────────

# Supabase — récupérer sur https://supabase.com/dashboard/project/[ID]/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — récupérer sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Prix Stripe (IDs depuis Stripe Dashboard)
STRIPE_PRICE_WEEK=
STRIPE_PRICE_MONTH=
STRIPE_PRICE_YEAR=

# URLs
NEXT_PUBLIC_SITE_URL=https://copiqpolice.app
STRIPE_SUCCESS_URL=https://copiqpolice.app/abonnement?success=true
STRIPE_CANCEL_URL=https://copiqpolice.app/abonnement?canceled=true
STRIPE_PORTAL_RETURN_URL=https://copiqpolice.app/abonnement

# Google Ads (pour utilisateurs gratuits)
NEXT_PUBLIC_GOOGLE_ADS_CLIENT_ID=

# Analytics (optionnel)
NEXT_PUBLIC_FIREBASE_API_KEY=
